<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Base -->
    <item>
        <shape>
            <gradient
                android:startColor="#12121A"
                android:endColor="#0E0E15"
                android:angle="270"/>
        </shape>
    </item>

    <!-- Softer Divider -->
    <item android:gravity="top">
        <shape>
            <size android:height="1dp"/>
            <solid android:color="#252534"/>
        </shape>
    </item>

</layer-list>