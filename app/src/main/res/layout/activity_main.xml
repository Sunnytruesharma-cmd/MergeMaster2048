<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#090912">

    <!-- ================= TOP BAR ================= -->

    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="50dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingTop="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="16dp">

        <FrameLayout
            android:id="@+id/btnPause"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_tile"
            android:layout_marginEnd="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_pause_button"
                android:contentDescription="Pause"/>
        </FrameLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="110dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_tile"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_diamond"
                android:contentDescription="Diamond"/>

            <TextView
                android:id="@+id/txtCurrency"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:minWidth="110dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_button_tile"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:src="@drawable/ic_crown"
                android:contentDescription="Best Score"/>

            <TextView
                android:id="@+id/txtBestScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:text="0"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <FrameLayout
            android:id="@+id/btnSettings"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/bg_button_tile"
            android:layout_marginStart="12dp"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_setting_green"
                android:contentDescription="Settings"/>
        </FrameLayout>

    </LinearLayout>

    <!-- ================= GAME VIEW ================= -->

    <com.firefinix.freestyle2048game.GameView
        android:id="@+id/gameView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- ================= BOTTOM TOOLBAR ================= -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="75dp"
        android:orientation="horizontal"
        android:gravity="center">

        <!-- Square -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button_tile">

            <ImageView
                android:id="@+id/btnHammer"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_hammer"
                android:contentDescription="Hammer"/>
        </FrameLayout>

        <!-- Hex -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button_hexagon">

            <ImageView
                android:id="@+id/btnSwipe"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_swipe_tiles"
                android:contentDescription="Swipe"/>
        </FrameLayout>

        <!-- Square -->
        <FrameLayout
            android:id="@+id/btnCombo"
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button_tile"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_combo"
                android:contentDescription="Combo"/>
        </FrameLayout>

        <!-- Hex (Highlighted) -->
        <FrameLayout
            android:id="@+id/btnReward"
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_reward_hexagon"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_ad"
                android:contentDescription="Reward Ad"/>
        </FrameLayout>

        <!-- Square -->
        <FrameLayout
            android:layout_width="46dp"
            android:layout_height="46dp"
            android:layout_margin="8dp"
            android:background="@drawable/bg_button_tile">

            <ImageView
                android:id="@+id/btnReset"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_undo"
                android:contentDescription="Reset"/>
        </FrameLayout>

    </LinearLayout>

    <!-- ================= ADS SPACE ================= -->

    <FrameLayout
        android:id="@+id/adContainer"
        android:layout_width="match_parent"
        android:layout_height="60dp" />

</LinearLayout>