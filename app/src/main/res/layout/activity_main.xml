<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0B14">

    <!-- ========================= -->
    <!-- TOP HUD BAR -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/topHud"
        android:layout_width="0dp"
        android:layout_height="80dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="#111118"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtScore"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Score: 0"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"/>

        <TextView
            android:id="@+id/txtGems"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="💎 0"
            android:textColor="#00E5FF"
            android:textSize="16sp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/txtCrowns"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="👑 0"
            android:textColor="#FFD700"
            android:textSize="16sp"
            android:layout_marginEnd="16dp"/>

        <TextView
            android:id="@+id/txtNextTile"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Next: 2"
            android:textColor="#FF80AB"
            android:textSize="16sp"
            android:textStyle="bold"/>

    </LinearLayout>

    <!-- ========================= -->
    <!-- GAME VIEW -->
    <!-- ========================= -->

    <com.firefinix.freestyle2048game.GameView
        android:id="@+id/gameView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/topHud"
        app:layout_constraintBottom_toTopOf="@id/buttonContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- ========================= -->
    <!-- BOTTOM BUTTONS -->
    <!-- ========================= -->

    <LinearLayout
        android:id="@+id/buttonContainer"
        android:layout_width="0dp"
        android:layout_height="90dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#111118"
        android:padding="12dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <Button
            android:id="@+id/btnHammer"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="HAMMER"/>

        <Button
            android:id="@+id/btnShuffle"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="SHUFFLE"/>

        <Button
            android:id="@+id/btnReset"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="RESET"/>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>